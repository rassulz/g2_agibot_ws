std_msgs/Header header  # frame_id 无用, timestamp 发送时间

############################################################
# 标定类型
############################################################
uint8 CALIB_DEFAULT     = 0  # 根据默认配置去标定（标定位置和标定时长根据MC的默认配置来执行）
uint8 CALIB_ZERO_OFFSET = 1  # 零偏标定（机械臂在力零位去标定，适合无负载情况。标定结果不强依赖urdf，更为准确，适合第一次出厂标定使用）
uint8 CALIB_RANDOM      = 2  # 当前位置标定（机械臂在任意位置去标定，适合末端有工具的情况） 
uint8 calib_type

############################################################
# 标定时间设置
############################################################
float64 calib_duration     # 标定采样持续时间（秒），0 表示使用系统默认时长

string uuid    
string detail 
