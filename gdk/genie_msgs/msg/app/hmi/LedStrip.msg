# 每个灯的控制命令（RGB + 点亮方式 + 速度）
# 数值范围均为 0~255（uint8）

# 目标灯的索引/ID（自己定义：从0开始、物理地址、或逻辑分组内编号）
uint16 lamp_id

# 颜色
uint8 r              # 0~255，红
uint8 g              # 0~255，绿
uint8 b              # 0~255，蓝

# 点亮方式（模式）
# 0: 不点亮
# 1: 同步点亮（常亮/静态）
# 2: 流水点亮（正向）
# 3: 反流水点亮（反向）
# 4: 呼吸点亮
# 5: 闪烁点亮
# 6~255: 预留
uint8 mode

# 速度/周期参数（单位步长=25ms）
# 取值 0~255 -> 0s ~ 6.375s（25ms 的倍数）
# 含义示例：
#   - 呼吸/闪烁：完整一次明暗/亮灭的周期时长
#   - 流水/反流水：每步移动/刷新间隔
uint8 speed